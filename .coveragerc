[run]
source =
    users
    books
    borrowings
    notifications
    payments
omit =
    users/migrations/*
    users/tests.py
    books/migrations/*
    books/tests.py
    borrowings/migrations/*
    borrowings/tests.py
    notifications/tests.py
    payments/tests.py

[report]
fail_under = 60
show_missing = True
